{
  "expo": {
    "name": "Vialbum",
    "slug": "vialbum",
    "scheme": "vialbum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": false }],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vialbum uses library access so you can select travel photos for journeys and videos for Moments.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vialbum uses photo access to show your library and let you select photos for a journey.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ],
          "preventAutomaticLimitedAccessAlert": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "bundleIdentifier": "com.vialbum.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vialbum.app",
      "predictiveBackGestureEnabled": false
    }
  }
}
