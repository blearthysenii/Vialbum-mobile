{
  "expo": {
    "name": "Vialbum",
    "slug": "vialbum",
    "scheme": "vialbum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vialbum.app"
    },
    "android": {
      "package": "com.vialbum.app",
      "predictiveBackGestureEnabled": false
    }
  }
}
