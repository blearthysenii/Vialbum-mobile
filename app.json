{
  "expo": {
    "name": "Vialbum",
    "slug": "vialbum",
    "scheme": "vialbum",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vialbum uses photo access so you can add selected travel photos to your private journeys.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "bundleIdentifier": "com.vialbum.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vialbum.app",
      "predictiveBackGestureEnabled": false
    }
  }
}
